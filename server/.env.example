PORT=3000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Brevo SMTP (use the SMTP login and SMTP key from Brevo, not an API key)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
# Must be a sender address verified in your Brevo account
MAIL_FROM="Uni-Reas <your-verified-sender@example.com>"
# Optional: restrict registration to your university domain, e.g. pondiuni.ac.in
ALLOWED_EMAIL_DOMAIN=

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uni_reas
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION_LIMIT=10
