PORT=3000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# SMTP settings (Gmail example: use an App Password, never your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Uni-Reas <your-email@gmail.com>"
# Optional: restrict registration to your university domain, e.g. pondiuni.ac.in
ALLOWED_EMAIL_DOMAIN=
